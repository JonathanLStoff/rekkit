{
  "tracker-prime": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ../scripts/fleet/hook.sh prime agy",
        "timeout": 30
      }
    ]
  },
  "guard-shell": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../scripts/fleet/hook.sh shell agy",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "guard-paths": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../scripts/fleet/hook.sh paths agy",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "guard-read": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|view_content_chunk|grep_search|search_in_file|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../scripts/fleet/hook.sh read agy",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "port-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "bash ../scripts/fleet/hook.sh gate agy",
        "timeout": 900
      }
    ]
  },
  "journal-spawn": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../scripts/fleet/hook.sh spawn agy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
