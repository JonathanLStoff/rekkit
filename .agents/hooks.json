{
  "guard-shell": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "command": "./scripts/fleet/guard.sh", "timeout": 10 }]
      }
    ]
  },
  "guard-paths": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [{ "command": "./scripts/fleet/guard-paths.sh", "timeout": 10 }]
      }
    ]
  },
  "port-gate": {
    "Stop": [
      { "command": "./scripts/fleet/tests-gate.sh", "timeout": 900 }
    ]
  }
}
