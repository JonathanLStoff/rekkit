{
  "guard-shell": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "../scripts/fleet/hook.sh shell agy", "timeout": 10 }]
      }
    ]
  },
  "guard-paths": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{ "type": "command", "command": "../scripts/fleet/hook.sh paths agy", "timeout": 10 }]
      }
    ]
  },
  "port-gate": {
    "Stop": [
      { "type": "command", "command": "../scripts/fleet/hook.sh gate agy", "timeout": 900 }
    ]
  }
}
