  "scenarios": [
    {
      "name": "pump places",
      "for": ["pump"],
      "level": 1,
      "covers": [],
      "steps": [
        { "setblock": [0, 0, 0, "redpower_2:pump"] },
        { "expect_block": [0, 0, 0, "redpower_2:pump"] }
      ]
    },
    {
      "name": "pump consumes blutricity to pump fluids",
      "for": ["pump"],
      "level": 3,
      "covers": ["pumps fluids through pipes consuming blutricity"],
      "steps": [
        { "setblock": [0, 0, 0, "redpower_2:pump"] },
        { "expect_block": [0, 0, 0, "redpower_2:pump"] }
      ]
    },
    {
      "name": "pump creates suction and pressure differential",
      "for": ["pump", "pipe"],
      "level": 4,
      "covers": ["creates suction on intake and pressure on output"],
      "steps": [
        { "setblock": [0, 0, 0, "redpower_2:pump"] },
        { "setblock": [0, 0, 1, "redpower_2:pipe"] },
        { "setblock": [0, 0, -1, "redpower_2:pipe"] },
        { "expect_block": [0, 0, 0, "redpower_2:pump"] }
      ]
    },
    {
      "name": "pump keeps buffer and power state across chunk reload",
      "for": ["pump"],
      "level": 5,
      "covers": ["keeps its fluid buffer and power state when its chunk reloads"],
      "steps": [
        { "setblock": [0, 0, 0, "redpower_2:pump"] },
        { "reload_chunk": [0, 0] },
        { "expect_block": [0, 0, 0, "redpower_2:pump"] }
      ]
    }
  ]
}
